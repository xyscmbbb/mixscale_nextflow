params {
    h5ad = null
    pair_csv = null
    perturb_gene = null
    outdir = "results"

    // Metadata / annotation columns
    target_gene_col = "target_gene"
    cell_col = "cell"
    guide_col = "pair_key"

    // Non-targeting control label
    nt_label = "ONE_INTERGENIC_SITE"

    // h5ad conversion options
    max_features = 60609
    subset_to_gene = true

    // Mixscale preprocessing options
    ndims = 30
    num_neighbors = 20
    chunk_cells = 3000
    min_de_genes = 0
    max_de_genes = 100
    logfc_threshold = 0

    // Step-2 parallelism. Every gene row in the DE-gene rank-sum and every
    // query row in the kNN is independent, so both fan out over forked workers
    // and reassemble in chunk order -- bit-identical to serial, verified on the
    // HeLa/RPL9 and CM/PDHA1 gates. `null` = use task.cpus; set 1 for serial.
    // Without this step 2 runs single-threaded and the fixes are inert.
    step2_threads = null

    // DE-gene-selection block size in NONZEROS (not genes). Sets the outer block
    // and, divided by the worker count, each worker's presto chunk. Leave it
    // here: cutting it 3x at 305k moved the container peak by 0.07 GB and cost
    // 257 s (DE selection 279.5 -> 555.6 s) for an identical R heap. The peak it
    // was meant to attack turned out to be Seurat's VST kernels, not the forked
    // workers -- see docs/SCALING.md.
    de_target_nnz = 1.2e8

    // Weighted DE (step 3) gene-filter thresholds. Now forwarded to step 3 so
    // they are actually tunable from the launch command. Raising min_pct prunes
    // the gene set fed to glm_gp -> shorter runtime. Defaults reproduce the
    // original (unfiltered) behavior.
    min_pct = 0
    min_cells_group = 10

    // glm_gp / Mixscale DE option. The collapsed solver is exact only against an
    // unsubsampled fit, so this branch defaults it off.
    subsample = false

    // Fit step 3 with the collapsed Gamma-Poisson solver instead of stock
    // glm_gp. Exact (same design, same optimizer, same objective -- only the
    // per-cell sums are replaced by per-design-row sums), and it removes the
    // dense n_genes x n_cells Mu that otherwise bounds how many cells a job can
    // hold. Requires subsample = false. Defaulted ON here: this branch targets
    // genome-wide screens where the stock path does not fit at all (at 300k NT
    // its dense Mu alone is 31,729 x 305,110 x 8B = 77 GB).
    collapsed = true

    // Resource parameters.
    //
    // Cromwell sizes a separate VM per task, so per-step sizing is real money:
    // provisioning step 1 at step 3's peak wastes the difference on every one of
    // the 5,000 jobs. Each step below falls back to `cpus` / `memory` when left
    // null, preserving the old single-knob behaviour.
    //
    // Measured peaks (anonymous RSS, whole process tree) -- see docs/SCALING.md:
    //   17.7k cells (CM, 10.9k NT) : step1 7.7 GB  step2 9.8 GB  step3 8.6 GB
    //   305k cells  (300k NT)      :                             step3 71.8 GB
    // Peak memory at scale is dominated by holding the NT counts, not by the
    // solver, so size step 3 from the NT pool size rather than the gene count.
    cpus = 8
    memory = "64 GB"

    cpus_step1 = null
    cpus_step2 = null
    cpus_step3 = null
    mem_step1  = null
    mem_step2  = null
    mem_step3  = null
}

process {
    executor = "local"
    // 1.1.9 = 1.1.8 plus the transpose-free HVG kernels, compiled at image-build
    // time and exported as MIXSCALE_HVF_SO (see docker/). On 1.1.8 the scripts
    // still work -- they compile the kernels into a tempdir at job start and say
    // so in the log -- but that is a second per job across the whole screen.
    container = "docker.io/xyscmbbb/r-mixscale:1.1.9"
    errorStrategy = "terminate"
}

docker {
    enabled = true
}

cleanup = true