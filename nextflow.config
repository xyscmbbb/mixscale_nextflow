params {
    h5ad = null
    pair_csv = null
    perturb_gene = null
    outdir = "results"

    // Metadata / annotation columns
    target_gene_col = "target_gene"
    cell_col = "cell"
    guide_col = "pair_key"

    // Non-targeting control label
    nt_label = "ONE_INTERGENIC_SITE"

    // h5ad conversion options
    max_features = 60609
    subset_to_gene = true

    // Mixscale preprocessing options
    ndims = 30
    num_neighbors = 20
    chunk_cells = 3000
    min_de_genes = 0
    max_de_genes = 100
    logfc_threshold = 0

    // glm_gp / Mixscale DE option
    subsample = true

    // Resource parameters
    cpus = 8
    memory = "64 GB"
}

process {
    executor = "local"
    container = "docker.io/xyscmbbb/r-mixscale:1.1.7"
    errorStrategy = "terminate"
}

docker {
    enabled = true
}

cleanup = true