params {
    h5ad = null
    pair_csv = null
    perturb_gene = null
    outdir = "results"

    // Metadata / annotation columns
    target_gene_col = "target_gene"
    cell_col = "cell"
    guide_col = "pair_key"

    // Non-targeting control label
    nt_label = "ONE_INTERGENIC_SITE"

    // h5ad conversion options
    max_features = 60609
    subset_to_gene = true

    // glm_gp / Mixscale DE option
    subsample = true

    // Resource parameters
    cpus = 8
    memory = "64 GB"
}

process {
    executor = "local"
    container = "docker.io/xyscmbbb/r-mixscale:1.1.7"
    errorStrategy = "terminate"
}

docker {
    enabled = true
}

cleanup = true
