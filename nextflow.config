// Default workflow parameters. These can be overridden at runtime, e.g. --subsample false
params {
  subsample = true
}

process.executor = 'local'

singularity.enabled = false
apptainer.enabled  = false
docker.enabled     = true

// Delete successful task work directories after the final outputs are published.
// Failed task work directories are kept for debugging.
cleanup = true

process {
  withName: CONVERT_H5AD_TO_OBJ {
    cpus   = 1
    memory = '40 GB'
    time   = '12h'
  }

  withName: MIXSCALE_PREPROCESS {
    cpus   = 1
    memory = '40 GB'
    time   = '24h'
  }

  withName: RUN_WMVREGDE_SCALED_DEBUG {
    cpus   = 1
    memory = '40 GB'
    time   = '24h'
  }
}

